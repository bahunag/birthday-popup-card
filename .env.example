# =====================================================================
# 生日立体弹出贺卡 Skill —— AI 接口配置示例模板
# 说明：
# 1. 如果您当前使用的 AI Agent 自身【已具备看图识图 + 绘画生图能力】
#    （例如 Antigravity、千问多模态智能体等），本文件【不需要填写】！
# 2. 如果您在纯命令行编码助手（例如 Claude Code、Codex、本地终端）中运行，
#    需要由后台 Python 脚本代为调用视觉与绘画大模型时，
#    请将本文件复制为 `.env`，并填入您选用的某一家模型密钥即可。
# =====================================================================

# 模型服务商选择：dashscope（阿里云百炼推荐） | gemini | openai
CARD_AI_PROVIDER=dashscope

# ---------- 方式一：阿里云百炼 DashScope（通义千问视觉 + 万相绘画） ----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_VISION_MODEL=qwen-vl-max
DASHSCOPE_IMAGE_MODEL=wan2.6-image

# ---------- 方式二：Google Gemini API（多模态识图 + 生图） ----------
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---------- 方式三：OpenAI 兼容接口 ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
